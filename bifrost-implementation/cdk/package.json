{
  "name": "bifrost-gateway-cdk",
  "version": "1.0.0",
  "description": "CDK app for deploying Bifrost AI Gateway on AWS",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "deploy:all": "cdk deploy --all --require-approval never",
    "deploy:core": "cdk deploy BifrostVpcStack BifrostStack --require-approval never",
    "deploy:cloudfront": "cdk deploy BifrostCloudfrontStack --require-approval never",
    "deploy:observability": "cdk deploy BifrostObservabilityStack --require-approval never",
    "deploy:grafana": "cdk deploy BifrostGrafanaStack --require-approval never",
    "destroy": "cdk destroy --all --force",
    "synth": "cdk synth"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^18.0.0",
    "aws-cdk": "^2.150.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.150.0",
    "constructs": "^10.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
