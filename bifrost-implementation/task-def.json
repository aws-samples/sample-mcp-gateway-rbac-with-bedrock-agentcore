{
  "_comment": [
    "===========================================================================",
    "BIFROST TASK DEFINITION — PLACEHOLDER FILE",
    "===========================================================================",
    "This file is a REFERENCE TEMPLATE. Do NOT deploy it directly.",
    "",
    "Before using, replace all PLACEHOLDER values with your own:",
    "",
    "  YOUR_AWS_ACCOUNT_ID   → Your 12-digit AWS account ID",
    "                          Run: aws sts get-caller-identity --query Account",
    "",
    "  YOUR_AWS_REGION       → Your deployment region (e.g. us-east-1)",
    "",
    "  YOUR_ARTIFACT_BUCKET  → Your S3 artifacts bucket name",
    "                          Format: bifrost-artifacts-<ACCOUNT>-<REGION>",
    "",
    "HOW TO GET THESE VALUES AUTOMATICALLY:",
    "  The deploy-bifrost.sh script creates all values dynamically.",
    "  Run: cd bifrost-implementation/scripts && ./deploy-bifrost.sh --admin-email you@example.com",
    "",
    "HOW TO REGISTER THE TASK DEFINITION MANUALLY:",
    "  1. Replace all PLACEHOLDER values below",
    "  2. Run: aws ecs register-task-definition --cli-input-json file://task-def.json",
    "",
    "ENCRYPTION KEY (BIFROST_ENCRYPTION_KEY):",
    "  Generated automatically by deploy-bifrost.sh and stored in Secrets Manager.",
    "  SSM path: /bifrost/encryption-key",
    "  To create manually:",
    "    python3 -c \"import secrets,string; print(''.join(secrets.choice(string.ascii_letters+string.digits) for _ in range(32)))\"",
    "    aws secretsmanager create-secret --name /bifrost/encryption-key --secret-string '{\"key\":\"<generated-key>\"}'",
    "",
    "VIRTUAL KEYS (BIFROST_VK_TEAM_ALPHA / BIFROST_VK_TEAM_BETA):",
    "  Generated by Bifrost Admin UI after you configure providers.",
    "  Store in SSM: aws ssm put-parameter --name /bifrost/virtual-keys/team-alpha --value sk-bf-... --type SecureString",
    "==========================================================================="
  ],
  "family": "bifrost-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "3072",
  "executionRoleArn": "arn:aws:iam::YOUR_AWS_ACCOUNT_ID:role/bifrost-ecs-execution-role",
  "taskRoleArn": "arn:aws:iam::YOUR_AWS_ACCOUNT_ID:role/bifrost-ecs-task-role",
  "volumes": [
    {
      "name": "bifrost-data",
      "efsVolumeConfiguration": {
        "fileSystemId": "YOUR_EFS_FILESYSTEM_ID",
        "transitEncryption": "ENABLED",
        "authorizationConfig": {
          "accessPointId": "YOUR_EFS_ACCESS_POINT_ID",
          "iam": "ENABLED"
        }
      }
    }
  ],
  "containerDefinitions": [
    {
      "name": "bifrost",
      "image": "maximhq/bifrost:latest",
      "essential": true,
      "command": ["-host", "0.0.0.0", "-port", "8080", "-app-dir", "/app/data"],
      "portMappings": [
        {"containerPort": 8080, "protocol": "tcp"}
      ],
      "environment": [
        {"name": "BIFROST_HOST",           "value": "0.0.0.0"},
        {"name": "APP_PORT",               "value": "8080"},
        {"name": "LOG_LEVEL",              "value": "info"},
        {"name": "LOG_STYLE",              "value": "json"},
        {"name": "TEAM_ALPHA_DAILY_LIMIT", "value": "100000"},
        {"name": "TEAM_BETA_DAILY_LIMIT",  "value": "50000"},
        {"name": "MONTHLY_TOKEN_LIMIT",    "value": "2000000"},
        {"name": "OTEL_SERVICE_NAME",      "value": "bifrost-gateway"}
      ],
      "secrets": [
        {
          "name": "BIFROST_ENCRYPTION_KEY",
          "valueFrom": "arn:aws:secretsmanager:YOUR_AWS_REGION:YOUR_AWS_ACCOUNT_ID:secret:/bifrost/encryption-key"
        }
      ],
      "mountPoints": [
        {"sourceVolume": "bifrost-data", "containerPath": "/app/data", "readOnly": false}
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "wget -qO- http://localhost:8080/health || exit 1"],
        "interval": 30,
        "timeout": 10,
        "retries": 3,
        "startPeriod": 90
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group":         "/bifrost/container",
          "awslogs-region":        "YOUR_AWS_REGION",
          "awslogs-stream-prefix": "bifrost"
        }
      },
      "ulimits": [
        {"name": "nofile", "softLimit": 65536, "hardLimit": 65536}
      ]
    }
  ]
}
