        <mxCell id="step-2-desc" parent="step-2-legend" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;RBAC + budget enforcement&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;LiteLLM checks the model against the team&amp;#39;s allowlist and remaining budget in PostgreSQL. Denied or over-budget requests are blocked before Bedrock (HTTP 401/429) — zero spend.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="348" x="52" as="geometry" />
        </mxCell>
        <mxCell id="step-3-legend" connectable="0" parent="legend-container" style="group;fontFamily=Helvetica;" value="" vertex="1">
          <mxGeometry height="90" width="400" y="180" as="geometry" />
        </mxCell>
        <mxCell id="step-3-badge" parent="step-3-legend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="3" vertex="1">
          <mxGeometry height="38" width="40" y="2" as="geometry" />
        </mxCell>
        <mxCell id="step-3-desc" parent="step-3-legend" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Route, invoke, attribute&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Allowed calls are signed with the task IAM role (SigV4) and routed to Bedrock. Responses may be cached in Redis; token cost is recorded per team/key for real-time attribution.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="348" x="52" as="geometry" />
        </mxCell>
        <mxCell id="legend-note" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontStyle=2;fontFamily=Helvetica;fontColor=light-dark(#3B3B3B,#E0E0E0);" value="Local dev mirrors this: LiteLLM + PostgreSQL + Redis run via Docker Compose; the container reads host AWS creds (bedrock-static profile) instead of an ECS task role." vertex="1">
          <mxGeometry height="80" width="400" x="1264" y="500" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
